# Copy to .env, chmod 600, then fill every required blank.
# Never commit .env or real credentials. Generate independent 32+ character secrets.
ADMIN_USERNAME=
ADMIN_PASSWORD=
APP_SECRET=
AGENT_TOKEN=

# Exact origin: scheme + hostname + optional port, no trailing slash or path.
PUBLIC_ORIGIN=https://guard.example.com
COOKIE_SECURE=true
# Keep SQLite inside the mounted data volume.
DATABASE_PATH=/data/guard.db
# Host reverse proxy can connect here. Backend has no host port.
UI_BIND_ADDRESS=127.0.0.1
UI_PORT=8080

# Optional bootstrap; safer to enter provider tokens in Settings after login.
CLOUDFLARE_API_TOKEN=
REMNAWAVE_URL=
REMNAWAVE_API_TOKEN=

# Optional immutable tags for updates/rollback (default: latest).
BACKEND_IMAGE=mitetenov/remnawave-dns-guard-backend:latest
FRONTEND_IMAGE=mitetenov/remnawave-dns-guard-frontend:latest
