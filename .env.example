# Copy to .env, chmod 600, then fill the required credentials below.
# Never commit .env or real credentials.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Generate each value independently with: openssl rand -hex 32
# Keep APP_SECRET with database backups; changing it prevents decryption.
APP_SECRET=
# Use the same AGENT_TOKEN in the RU agent's .env.
AGENT_TOKEN=

# Exact origin: scheme + hostname + optional port, no trailing slash or path.
PUBLIC_ORIGIN=https://guard.example.com
COOKIE_SECURE=true

# Backend runtime defaults. Keep :8000 for the bundled nginx upstream.
LISTEN_ADDR=:8000
# Keep SQLite inside the mounted data volume.
DATABASE_PATH=/data/guard.db

# Host reverse proxy can connect here. Backend has no host port.
UI_BIND_ADDRESS=127.0.0.1
UI_PORT=8080

# Optional bootstrap; safer to enter provider tokens in Settings after login.
CLOUDFLARE_API_TOKEN=
REMNAWAVE_URL=
REMNAWAVE_API_TOKEN=

# UpCloud orders and replacements. The backend image contains the playbooks and collections.
# Enable COMPOSE_FILE after preparing ./replacement and adding the second YAML file.
# COMPOSE_FILE=docker-compose.yaml:docker-compose.replacements.yaml
# docker-compose.replacements.yaml sets these defaults and mounts ./replacement read-only.
# REPLACEMENT_ANSIBLE_SSH_USER=root
# REPLACEMENT_ANSIBLE_SSH_KEY=/run/dns-guard/replacement/ssh_key
# REPLACEMENT_ANSIBLE_TIMEOUT=20m
# Contact for Certbot in the bundled playbooks. Ansible group_vars can also supply it.
# REPLACEMENT_ANSIBLE_CERTBOT_EMAIL=admin@example.com
# XHTTP path for the bundled CDN playbook. Upstream defaults to 127.0.0.1:8443.
# REPLACEMENT_ANSIBLE_XHTTP_PATH=/your-xhttp-path/
# REPLACEMENT_ANSIBLE_XHTTP_UPSTREAM=127.0.0.1:8443
# Optional directory for group-specific overrides.
# REPLACEMENT_ANSIBLE_GROUP_VARS_DIR=/run/dns-guard/replacement/group_vars

# Optional external inventory and playbooks for manually linked nodes.
# REPLACEMENT_ANSIBLE_MANUAL_REPO_DIR=/run/dns-guard/replacement/ansible
# REPLACEMENT_ANSIBLE_NODE_VARS_DIR=/run/dns-guard/replacement/node_vars
# REPLACEMENT_ANSIBLE_KNOWN_HOSTS=/run/dns-guard/replacement/known_hosts

# Optional external playbooks for orders and manually linked nodes.
# REPLACEMENT_ANSIBLE_REPO_DIR=/run/dns-guard/replacement/ansible

# Separate install/tuning playbooks can also be mounted via your own Compose override.
# In that mode leave REPLACEMENT_ANSIBLE_MANUAL_REPO_DIR and REPLACEMENT_ANSIBLE_REPO_DIR unset.
# REPLACEMENT_ANSIBLE_INSTALL_PLAYBOOK=/run/dns-guard/replacement/install.yml
# REPLACEMENT_ANSIBLE_TUNING_PLAYBOOK=/run/dns-guard/replacement/tuning.yml
