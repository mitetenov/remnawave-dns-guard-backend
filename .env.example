# Copy to .env, chmod 600, then fill the required credentials below.
# Never commit .env or real credentials.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Generate each value independently with: openssl rand -hex 32
# Keep APP_SECRET with database backups; changing it prevents decryption.
APP_SECRET=
# Use the same AGENT_TOKEN in the RU agent's .env.
AGENT_TOKEN=

# Exact origin: scheme + hostname + optional port, no trailing slash or path.
PUBLIC_ORIGIN=https://guard.example.com
COOKIE_SECURE=true

# Backend runtime defaults. Keep :8000 for the bundled nginx upstream.
LISTEN_ADDR=:8000
# Keep SQLite inside the mounted data volume.
DATABASE_PATH=/data/guard.db

# Host reverse proxy can connect here. Backend has no host port.
UI_BIND_ADDRESS=127.0.0.1
UI_PORT=8080

# Optional bootstrap; safer to enter provider tokens in Settings after login.
CLOUDFLARE_API_TOKEN=
REMNAWAVE_URL=
REMNAWAVE_API_TOKEN=
